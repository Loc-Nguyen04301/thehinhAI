# Copy file này thành .env.local rồi điền giá trị. KHÔNG commit .env.local.

# --- MongoDB (Atlas) ---
# Atlas → Database → Connect → Drivers → copy chuỗi kết nối, thay <password>.
# Mật khẩu có ký tự đặc biệt (@ : / ? #) thì phải URL-encode.
# Deploy Vercel: Atlas → Network Access phải cho phép IP của Vercel (0.0.0.0/0, vì Vercel không có IP cố định);
# thiếu bước này đăng nhập sẽ lỗi 500 "MongoServerSelectionError … SSL alert number 80".
MONGODB_URI=
# (Không bắt buộc) Tên database. Mặc định lấy từ đường dẫn trong MONGODB_URI.
MONGODB_DB=thehinh-ai

# --- Better Auth ---
# Chuỗi ngẫu nhiên ≥ 32 ký tự. Tạo bằng: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# URL gốc của website. Trên Vercel (Production): https://thehinh-ai.vercel.app — KHÔNG để localhost.
BETTER_AUTH_URL=http://localhost:5000
# (Không bắt buộc) Thêm origin khác được phép, cách nhau bởi dấu phẩy.
# VD để thử trên điện thoại qua wifi: http://192.168.1.114:5000
# Trên Vercel không cần: URL của từng lần deploy / nhánh / production được tin tự động (lib/auth.ts).
# BETTER_AUTH_TRUSTED_ORIGINS=

# --- Đăng nhập Google (không bắt buộc — bỏ trống thì ẩn nút Google) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:5000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Claude (Đo kcal bằng ảnh) ---
# Tạo key tại https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# (Không bắt buộc) Model Claude. Mặc định: claude-sonnet-5
# ANTHROPIC_MODEL=claude-sonnet-5
